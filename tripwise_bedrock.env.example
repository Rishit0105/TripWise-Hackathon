# Amazon Bedrock conversational assistant settings
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
TRIPWISE_MCP_URL=http://127.0.0.1:8001/mcp

# Prefer `aws configure` / an AWS profile rather than committing credentials.
# If using environment variables, set these in your local shell only:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...  # only for temporary credentials
