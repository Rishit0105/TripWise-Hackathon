# Optional: enables model-powered tool use in the TripWise copilot.
# Without OPENAI_API_KEY, the built-in fallback remains available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint, e.g. for a compatible provider:
# OPENAI_BASE_URL=https://your-provider.example/v1

# Existing optional activity search integration:
# GOOGLE_PLACES_API_KEY=
